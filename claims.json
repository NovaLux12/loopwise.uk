{
  "$comment": [
    "Every verifiable factual claim the site makes, with the source it must agree",
    "with. scripts/verify-claims.mjs re-checks each one against the live GitHub",
    "API and exits non-zero on drift, so a stale claim fails CI instead of",
    "quietly rotting on a page. This generalises the stale-claim-reaper workflow",
    "in carelink-api-research from research claims to the claims this site publishes.",
    "",
    "Add a claim here whenever a number or name appears in the HTML. If a claim",
    "cannot be machine-checked, do not add it — and do not state it as a fact."
  ],
  "version": 1,
  "owner": "NovaLux12",
  "repos": {
    "bridge": "NovaLux12/carelink-bridge",
    "reports": "NovaLux12/ns-reports",
    "graph": "NovaLux12/ns-cgm-graph",
    "research": "NovaLux12/carelink-api-research",
    "mcp": "NovaLux12/nightscout-mcp"
  },
  "claims": [
    {
      "id": "bridge.licence",
      "assertedIn": [
        "build.html#repos",
        "index.html#proof"
      ],
      "check": {
        "type": "repo",
        "repo": "bridge",
        "field": "license.spdx_id"
      },
      "expect": "MIT",
      "htmlMustContain": {
        "build.html": "Public &middot; MIT"
      }
    },
    {
      "id": "bridge.language",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "repo",
        "repo": "bridge",
        "field": "language"
      },
      "expect": "TypeScript"
    },
    {
      "id": "bridge.isFork",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "repo",
        "repo": "bridge",
        "field": "fork"
      },
      "expect": true,
      "note": "The site discloses the fork. If this ever becomes false, the disclosure must change too."
    },
    {
      "id": "bridge.forkParent",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "repo",
        "repo": "bridge",
        "field": "parent.full_name"
      },
      "expect": "domien-f/carelink-bridge",
      "htmlMustContain": {
        "build.html": "domien-f/carelink-bridge"
      }
    },
    {
      "id": "bridge.releaseCount",
      "assertedIn": [
        "index.html#proof",
        "build.html#releases"
      ],
      "check": {
        "type": "releaseCount",
        "repo": "bridge"
      },
      "expect": 10,
      "note": "Homepage says 'Ten releases so far'. build.html#releases also says '10 releases'.",
      "htmlMustContain": {
        "index.html": "Ten releases so far",
        "build.html": "<h3>10 releases</h3>"
      }
    },
    {
      "id": "bridge.latestReleaseTag",
      "assertedIn": [
        "build.html#repos",
        "build.html#releases",
        "build.html (announce bar)"
      ],
      "check": {
        "type": "latestRelease",
        "repo": "bridge",
        "field": "tag_name"
      },
      "expect": "v0.3.1",
      "note": "Stated four times across /build/: the announce bar, the repo card, the releases card, and the stat subtitle range.",
      "htmlMustContain": {
        "build.html": "<b>carelink-bridge v0.3.1</b>"
      }
    },
    {
      "id": "bridge.latestReleaseDate",
      "assertedIn": [
        "build.html#releases"
      ],
      "check": {
        "type": "latestReleaseDate",
        "repo": "bridge"
      },
      "expect": "2026-11-12",
      "note": "The releases card prints this date in prose. Date-only, because a timestamp would fail on nothing but would be noise to compare.",
      "htmlMustContain": {
        "build.html": "12 November 2026"
      }
    },
    {
      "id": "bridge.latestReleaseMonth",
      "assertedIn": [
        "index.html#proof"
      ],
      "check": {
        "type": "latestReleaseMonth",
        "repo": "bridge"
      },
      "expect": "2026-11",
      "note": "Homepage kicker says 'Latest bridge release · November 2026'. Month resolution only: that is all the sentence claims.",
      "htmlMustContain": {
        "index.html": "Latest bridge release · November 2026"
      }
    },
    {
      "id": "project.totalReleaseCount",
      "assertedIn": [
        "build.html#top (stat row)"
      ],
      "check": {
        "type": "releaseCountSum",
        "repos": [
          "bridge",
          "reports",
          "graph",
          "research"
        ]
      },
      "expect": 12,
      "note": "The stat row states a total across the four public repos. Summed from the same four repos the page enumerates, so adding a repo to the page without adding it here fails.",
      "htmlMustContain": {
        "build.html": "<em>12</em></b><span>releases shipped across the public repos</span>"
      }
    },
    {
      "id": "bridge.ciNodeMatrix",
      "assertedIn": [
        "build.html#repos",
        "build.html#releases"
      ],
      "check": {
        "type": "numberArray",
        "repo": "bridge",
        "path": ".github/workflows/ci.yml",
        "key": "node"
      },
      "expect": "20,22",
      "note": "Page says 'CI on Node 20 and 22' in two places. Node majors are bare integers, which ciMatrix cannot read.",
      "htmlMustContain": {
        "build.html": "CI on Node 20 and 22"
      }
    },
    {
      "id": "reports.latestReleaseTag",
      "assertedIn": [
        "build.html#repos",
        "build.html#releases",
        "build.html#security (known gaps)"
      ],
      "check": {
        "type": "latestRelease",
        "repo": "reports",
        "field": "tag_name"
      },
      "expect": "v0.2.0",
      "note": "Was published 2026-10-23. The page claimed for weeks that 'No GitHub release object exists for it yet' — a claim with no check behind it, which is exactly why it rotted. This check exists to stop that recurring.",
      "htmlMustContain": {
        "build.html": "<h3>1 release, <code>v0.2.0</code></h3>"
      }
    },
    {
      "id": "reports.releaseCount",
      "assertedIn": [
        "build.html#releases"
      ],
      "check": {
        "type": "releaseCount",
        "repo": "reports"
      },
      "expect": 1
    },
    {
      "id": "bridge.adrCount",
      "assertedIn": [
        "build.html#repos",
        "build.html#contributing"
      ],
      "check": {
        "type": "dirCount",
        "repo": "bridge",
        "path": "docs/adr",
        "exclude": [
          "README.md"
        ]
      },
      "expect": 8,
      "note": "Site says 'eight architecture decision records' in two places.",
      "htmlMustContain": {
        "build.html": "Eight architecture decision records"
      }
    },
    {
      "id": "bridge.hasCodeOfConduct",
      "assertedIn": [
        "build.html#contributing"
      ],
      "check": {
        "type": "pathExists",
        "repo": "bridge",
        "path": "CODE_OF_CONDUCT.md"
      },
      "expect": true,
      "note": "The old site claimed no repository had one. It does."
    },
    {
      "id": "bridge.hasCodeowners",
      "assertedIn": [
        "build.html#contributing"
      ],
      "check": {
        "type": "pathExists",
        "repo": "bridge",
        "path": ".github/CODEOWNERS"
      },
      "expect": true,
      "htmlMustContain": {
        "build.html": "<code>CODEOWNERS</code>"
      }
    },
    {
      "id": "bridge.architectureDocPath",
      "assertedIn": [
        "build.html#quickstart"
      ],
      "check": {
        "type": "pathExists",
        "repo": "bridge",
        "path": "docs/ARCHITECTURE.md"
      },
      "expect": true,
      "note": "Site links it as docs/ARCHITECTURE.md. It is NOT at the repo root.",
      "htmlMustContain": {
        "build.html": "<code>docs/ARCHITECTURE.md</code>"
      }
    },
    {
      "id": "bridge.securityDoc",
      "assertedIn": [
        "build.html#quickstart"
      ],
      "check": {
        "type": "pathExists",
        "repo": "bridge",
        "path": "SECURITY.md"
      },
      "expect": true
    },
    {
      "id": "reports.licence",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "repo",
        "repo": "reports",
        "field": "license.spdx_id"
      },
      "expect": "MIT"
    },
    {
      "id": "reports.requiresPython",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "tomlKey",
        "repo": "reports",
        "path": "pyproject.toml",
        "key": "requires-python"
      },
      "expect": ">=3.9",
      "htmlMustContain": {
        "build.html": "Python, standard library only"
      }
    },
    {
      "id": "reports.ciPythonFloor",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "ciMatrix",
        "repo": "reports",
        "path": ".github/workflows/ci.yml",
        "key": "python-version"
      },
      "expect": "3.9",
      "note": "The old site claimed CI only exercised 3.11-3.13. It does not.",
      "htmlMustContain": {
        "build.html": "CI on Python 3.9 to 3.13"
      }
    },
    {
      "id": "reports.ciPythonCeiling",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "ciMatrix",
        "repo": "reports",
        "path": ".github/workflows/ci.yml",
        "key": "python-version",
        "pick": "max"
      },
      "expect": "3.13"
    },
    {
      "id": "graph.licence",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "repo",
        "repo": "graph",
        "field": "license.spdx_id"
      },
      "expect": "MIT"
    },
    {
      "id": "graph.latestReleaseTag",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "latestRelease",
        "repo": "graph",
        "field": "tag_name"
      },
      "expect": "v0.1.0"
    },
    {
      "id": "graph.ciPythonFloor",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "ciMatrix",
        "repo": "graph",
        "path": ".github/workflows/ci.yml",
        "key": "python-version"
      },
      "expect": "3.9",
      "htmlMustContain": {
        "build.html": "CI on Python 3.9 to 3.13"
      }
    },
    {
      "id": "graph.ciPythonCeiling",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "ciMatrix",
        "repo": "graph",
        "path": ".github/workflows/ci.yml",
        "key": "python-version",
        "pick": "max"
      },
      "expect": "3.13"
    },
    {
      "id": "research.licence",
      "assertedIn": [
        "build.html#repos"
      ],
      "check": {
        "type": "repo",
        "repo": "research",
        "field": "license.spdx_id"
      },
      "expect": "MIT"
    },
    {
      "id": "project.publicRepoCount",
      "assertedIn": [
        "index.html#proof",
        "build.html#repos"
      ],
      "check": {
        "type": "countPublicOf"
      },
      "expect": 4,
      "note": "Homepage says '5 repos, 4 public'.",
      "htmlMustContain": {
        "build.html": "repositories · four public and MIT",
        "index.html": "<b>5</b><span>repositories, 4 public</span>"
      }
    },
    {
      "id": "bridge.firstRealRunIssueOpen",
      "assertedIn": [
        "index.html#proof"
      ],
      "check": {
        "type": "issueState",
        "repo": "bridge",
        "number": 12
      },
      "expect": "open",
      "note": "Issue #12 tracks what the first real hardware run is expected to break; the homepage links to it as proof of honesty. Guarding its state, not a count: open_issues_count includes pull requests and drifts on every triage.",
      "htmlMustContain": {
        "index.html": "carelink-bridge/issues/12"
      }
    },
    {
      "id": "project.publicToolCount",
      "assertedIn": [
        "index.html#proof"
      ],
      "check": {
        "type": "countPublicTools"
      },
      "expect": 3,
      "note": "3 of the 4 tools are public; nightscout-mcp is not. Counted from the manifest's explicit tools list, not inferred from the repository count — the two happen to be related but are not the same measurement.",
      "htmlMustContain": {
        "index.html": "<em>4</em></b><span>tools, 3 public and MIT</span>"
      }
    }
  ],
  "tools": [
    "bridge",
    "reports",
    "graph",
    "mcp"
  ],
  "nonTools": [
    {
      "alias": "research",
      "why": "carelink-api-research is captured API evidence and research notes, not something anyone runs."
    }
  ]
}
